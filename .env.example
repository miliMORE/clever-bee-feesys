# Copy to .env and set a unique secret. Never commit .env.
# Django does not load this file by itself; export the variables into the environment.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Truthy values: 1, true, yes, on (case-insensitive). Unset or anything else is off.
# Use true for local runserver. Leave unset or false on Railway.
DEBUG=true

# Comma-separated hostnames. Required when DEBUG is off.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins with scheme. Example: https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Railway Postgres URL. Leave empty locally to use sqlite (db.sqlite3).
DATABASE_URL=

# Railway sets this at runtime. gunicorn binds to 0.0.0.0:$PORT.
PORT=8000
